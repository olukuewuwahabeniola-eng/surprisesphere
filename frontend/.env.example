# Leave empty while using the Vite dev server. It proxies /api to http://localhost:5050.
# Set this for a production build that calls the API directly.
VITE_API_URL=

# Optional. The words still show in the header and footer when these are empty.
# Add the real profile URLs when you have them. Do not invent a number.
VITE_TIKTOK_URL=
VITE_WHATSAPP_URL=
