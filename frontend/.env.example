# Leave empty for local Vite (proxies /api to http://localhost:5050)
# and for Vercel same-origin rewrites to /api.
# Only set this if the API is hosted on a different domain.
VITE_API_URL=

# WhatsApp ordering number is managed in Admin (/admin) or backend env
# WHATSAPP_BUSINESS_NUMBER. Do not hardcode a number in the frontend.
