# Leave empty for local Vite (proxies /api to http://localhost:5050)
# and for Vercel same-origin rewrites to /api.
# Only set this if the API is hosted on a different domain.
VITE_API_URL=

# Optional. The words still show in the header and footer when these are empty.
# Add the real profile URLs when you have them. Do not invent a number.
VITE_TIKTOK_URL=
VITE_WHATSAPP_URL=
