PORT=5050
# Preferred Mongo connection string for this project.
MONGO_URI=mongodb://127.0.0.1:27017/surprise-fashion-sphere
# Kept for compatibility with earlier local setup.
MONGODB_URI=mongodb://127.0.0.1:27017/surprise-fashion-sphere
# Comma-separated browser origins allowed to call the API.
# Include local Vite and the live Vercel URL.
CLIENT_URL=http://localhost:5174,https://surprisesphere.vercel.app
NODE_ENV=development

# Leave JWT blank until later stages provide real credentials.
JWT_SECRET=
# Cloudinary (required for admin product image uploads and admin review photos).
# Get these from your Cloudinary dashboard. Never put them in frontend env files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# WhatsApp ordering (digits only, with country code, no +). Example: 2348012345678
# Prefer saving this in Admin (/admin). Env is a fallback when Mongo has no value yet.
WHATSAPP_BUSINESS_NUMBER=

# Shared secret for /admin store settings. Send as header x-admin-key.
ADMIN_KEY=
